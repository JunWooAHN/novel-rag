{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run-manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "state": {
      "enum": [
        "created",
        "validated",
        "running",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "specification": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "\\S"
          },
          "to": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "state",
    "specification",
    "history"
  ],
  "additionalProperties": false
}
